#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=./scripts/lib.sh
source "$SCRIPT_DIR/lib.sh"

configuration=$(guest_configuration)
echo "Applying $configuration to Lima instance $INSTANCE"

limactl shell "$INSTANCE" -- \
  sudo nixos-rebuild boot --flake "$GUEST_ROOT#$configuration"

# lima-init recreates the host mounts during boot. Restarting avoids losing
# those imperative mounts during a live NixOS switch.
limactl restart "$INSTANCE"
